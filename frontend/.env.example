# Server-side only. The browser never calls the backend directly.
BACKEND_URL=http://localhost:18000
# Dev auth for the agent console: sends X-Agent-Id: agent-demo. Set to false behind ALB OIDC / Cognito.
AGENT_DEV_AUTH=true
# Set true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Split hosts (read at request time; unset = one host, customers on / and agents on /agent).
# On AGENT_BASE_URL's host, / serves the agent console; customer links made there point at CUSTOMER_BASE_URL.
# AGENT_BASE_URL=https://dev.agent.onboardassist.click
# CUSTOMER_BASE_URL=https://dev.app.onboardassist.click
